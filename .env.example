# Copy to .env for local development. Never commit a real .env file.

ENVIRONMENT=development
DEBUG=true

# API and workers connect with the restricted role.
DATABASE_URL=postgresql+psycopg://profile_app:profile_app@localhost:5433/profile_analyzer
# Alembic connects with the schema owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://profile_owner:profile_owner@localhost:5433/profile_analyzer

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

LOG_LEVEL=INFO
LOG_JSON=true

CORS_ORIGINS=["http://localhost:5173"]
