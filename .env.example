# Copy to .env for local development. Never commit a real .env file.

ENVIRONMENT=development
DEBUG=true

# API and workers connect with the restricted role.
DATABASE_URL=postgresql+psycopg://profile_app:profile_app@localhost:5433/profile_analyzer
# Alembic connects with the schema owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://profile_owner:profile_owner@localhost:5433/profile_analyzer

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

LOG_LEVEL=INFO
LOG_JSON=true

CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_BASE_URL=http://localhost:5173

# Session cookie (opaque session id inside a signed token).
# Production must supply a strong random JWT_SECRET and COOKIE_SECURE=true.
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ISSUER=profile-analyzer
SESSION_COOKIE_NAME=pa_session
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false

# Password fallback policy.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Institutional OIDC (leave disabled for password-only local development).
OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPES=openid email profile
